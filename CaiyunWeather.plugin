#!name=彩云天气定位与手动测试
#!desc=本地定位3km锚点与可信时间。07:30出门、17:00回家、20:30明日温差；12:00仅新增/更新有效官方预警，无变化安静。手动为预览不吞正式预警。缺权限明确降级；不是实时监控。
#!author=local-config
#!homepage=https://github.com/panjin9395/loon-weather

[Script]
http-request ^https:\/\/(weather-data\.apple|weatherkit\.apple|api\.weather)\.com\/ script-path=https://raw.githubusercontent.com/panjin9395/loon-weather/main/caiyun-location-v2.js, requires-body=false, timeout=20, tag=彩云天气定位
generic script-path=https://raw.githubusercontent.com/panjin9395/loon-weather/main/caiyun-location-v2.js, timeout=20, tag=彩云定位诊断
generic script-path=https://raw.githubusercontent.com/panjin9395/loon-weather/main/caiyun-weather-v2.js, timeout=60, tag=彩云天气手动测试

# 仍每天四个时刻，cron 按设备/Loon 时区；中国用户保持设备 Asia/Shanghai。
cron "30 7 * * *" script-path=https://raw.githubusercontent.com/panjin9395/loon-weather/main/caiyun-weather-v2.js, argument="scene=morning", timeout=60, tag=彩云天气出门摘要
cron "0 12 * * *" script-path=https://raw.githubusercontent.com/panjin9395/loon-weather/main/caiyun-weather-v2.js, argument="scene=noon", timeout=60, tag=彩云天气午间变化
cron "0 17 * * *" script-path=https://raw.githubusercontent.com/panjin9395/loon-weather/main/caiyun-weather-v2.js, argument="scene=evening", timeout=60, tag=彩云天气回家出行
cron "30 20 * * *" script-path=https://raw.githubusercontent.com/panjin9395/loon-weather/main/caiyun-weather-v2.js, argument="scene=night", timeout=60, tag=彩云天气明日预报

[MITM]
hostname = weather-data.apple.com, api.weather.com, weatherkit.apple.com
