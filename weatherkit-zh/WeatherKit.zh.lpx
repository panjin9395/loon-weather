# Modified by panjin9395: Chinese select values and pinned local adapted bundles. Apache-2.0; see weatherkit-zh/NOTICE.
#!name = 苹果天气增强 · 中文选项（非官方二改）
#!desc = iOS 18 & macOS 15 & watchOS 11\n1.解锁全部天气功能\n2.修改空气质量数据\n3.修改下一小时降水数据\n4.修改天气数据\n5.修改天气预警数据
#!openUrl = http://boxjs.com/#/app/iRingo.WeatherKit
#!author = VirgilClyne[https://github.com/VirgilClyne],WordlessEcho[https://github.com/WordlessEcho],001[https://github.com/001ProMax],hhh2210[https://github.com/hhh2210]
#!homepage = https://NSRingo.github.io/guide/Weather/weather-kit
#!icon = https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
#!tag =  iRingo
#!system = iOS,iPadOS,macOS,watchOS
#!date = 2026-08-29 08:12:58
#!version = 3.3.2
#!system_version = 18

[Argument]
DataSets = input,"airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,weatherAlerts",tag=[数据集],desc=选择需要解析并处理的数据集；未选择的数据槽始终保持原样透传，不作修改。
Weather.Provider = select,"彩云天气","苹果原始天气","和风天气",tag=[天气] 数据源,desc=使用选定的数据源替换天气数据。
WeatherAlerts.Provider = select,"和风天气网页","苹果原始天气","和风天气","彩云天气",tag=[天气预警] 数据源,desc=使用选定的数据源处理天气预警数据。
NextHour.Provider = select,"彩云天气","苹果原始天气","和风天气",tag=[未来一小时降水强度] 数据源,desc=使用选定的数据源填充未来一小时降水强度的数据。
AirQuality.Current.Pollutants.Provider = select,"彩云天气","和风天气",tag=[今日污染物] 数据源,desc=使用选定的数据源填补污染物数据。
AirQuality.Calculate.Algorithm = select,"欧盟空气质量指数（EU_EAQI）","不转换","德国空气质量指数（UBA）","美国即时空气指数（WAQI_InstantCast_US）","中国即时空气指数（WAQI_InstantCast_CN）","中国即时空气指数二〇二五草案（WAQI_InstantCast_CN_25_DRAFT）","加拿大空气健康指数（CA_AQHI）","香港空气健康指数（HK_AQHI）","中国多污染物健康指数（AQHI_Multi_CN）","中国及香港多污染物健康指数（AQHI_Multi_CN_HK）","中国致死风险健康指数（CN_DEATH_AQHI）","中国及香港致死风险健康指数（CN_DEATH_HK_AQHI）",tag=[iRingo内置算法] 算法,desc=使用内置算法，通过污染物数据本地计算空气指数。InstantCast源自于WAQI，美标版本使用了WAQI的臭氧标准。
API.ColorfulClouds.Token = input,"",tag=[API] 彩云天气令牌,desc=彩云天气 API 令牌
API.QWeather.Host = input,"devapi.qweather.com",tag=[API] 和风天气主机,desc=和风天气 API 使用的主机名
API.QWeather.Token = input,"",tag=[API] 和风天气令牌,desc=和风天气 API 令牌
API.WAQI.Token = input,"",tag=[API] WAQI 令牌,desc=WAQI API 令牌，填写此字段将自动使用WAQI高级API
Storage = select,"插件参数优先","持久化配置优先","内置默认配置",tag=[储存] 配置类型,desc=选择要使用的配置类型。未设置此选项或不通过此选项的旧版本的配置顺序依旧是 $persistentStore (BoxJs) > $argument > database。
LogLevel = select,"警告","关闭","错误","信息","调试","全部",tag=[调试] 日志等级,desc=选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP
DOMAIN,tether.edge.apple,REJECT-DROP
AND,((OR,((IP-ASN,714,no-resolve),(IP-ASN,6185,no-resolve))),(PROTOCOL,QUIC)),REJECT-DROP

[Script]
http-response ^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/ requires-body=1, script-path=https://raw.githubusercontent.com/panjin9395/loon-weather/main/weatherkit-zh/response.zh.bundle.js, tag=🌤 WeatherKit.api.v1.availability.response, argument=[{DataSets},{Weather.Provider},{WeatherAlerts.Provider},{NextHour.Provider},{AirQuality.Current.Pollutants.Provider},{AirQuality.Calculate.Algorithm},{API.ColorfulClouds.Token},{API.QWeather.Host},{API.QWeather.Token},{API.WAQI.Token},{Storage},{LogLevel}]
http-request ^https?:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/ script-path=https://raw.githubusercontent.com/panjin9395/loon-weather/main/weatherkit-zh/request.zh.bundle.js, tag=🌤 WeatherKit.api.v1.airQualityScale.request, argument=[{DataSets},{Weather.Provider},{WeatherAlerts.Provider},{NextHour.Provider},{AirQuality.Current.Pollutants.Provider},{AirQuality.Calculate.Algorithm},{API.ColorfulClouds.Token},{API.QWeather.Host},{API.QWeather.Token},{API.WAQI.Token},{Storage},{LogLevel}]
http-request ^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=[^&#]*-[0-9]{9}(?:&|$) script-path=https://raw.githubusercontent.com/panjin9395/loon-weather/main/weatherkit-zh/request.zh.bundle.js, tag=🌤 WeatherKit.api.v1.weatherAlerts.html.request, argument=[{DataSets},{Weather.Provider},{WeatherAlerts.Provider},{NextHour.Provider},{AirQuality.Current.Pollutants.Provider},{AirQuality.Calculate.Algorithm},{API.ColorfulClouds.Token},{API.QWeather.Host},{API.QWeather.Token},{API.WAQI.Token},{Storage},{LogLevel}]
http-request ^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=-?[0-9]+(?:\.[0-9]+)?,-?[0-9]+(?:\.[0-9]+)?(?:&|$) script-path=https://raw.githubusercontent.com/panjin9395/loon-weather/main/weatherkit-zh/request.zh.bundle.js, tag=🌤 WeatherKit.api.v1.weatherAlerts.api.request, argument=[{DataSets},{Weather.Provider},{WeatherAlerts.Provider},{NextHour.Provider},{AirQuality.Current.Pollutants.Provider},{AirQuality.Calculate.Algorithm},{API.ColorfulClouds.Token},{API.QWeather.Host},{API.QWeather.Token},{API.WAQI.Token},{Storage},{LogLevel}]
http-response ^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/ requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/panjin9395/loon-weather/main/weatherkit-zh/response.zh.bundle.js, tag=🌤 WeatherKit.api.v2.weather.response, argument=[{DataSets},{Weather.Provider},{WeatherAlerts.Provider},{NextHour.Provider},{AirQuality.Current.Pollutants.Provider},{AirQuality.Calculate.Algorithm},{API.ColorfulClouds.Token},{API.QWeather.Host},{API.QWeather.Token},{API.WAQI.Token},{Storage},{LogLevel}]

[MITM]
hostname = weatherkit.apple.com
